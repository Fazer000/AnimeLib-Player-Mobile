<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Card background starting at 4dp to align seamlessly with accent stripe -->
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg_color" />
            <corners
                android:topLeftRadius="0dp"
                android:bottomLeftRadius="0dp"
                android:topRightRadius="10dp"
                android:bottomRightRadius="10dp" />
            <stroke
                android:width="0.5dp"
                android:color="@color/comment_input_stroke" />
        </shape>
    </item>
    <!-- Left purple accent stripe -->
    <item
        android:width="4dp"
        android:gravity="left">
        <shape android:shape="rectangle">
            <solid android:color="@color/purple_primary" />
            <corners
                android:topLeftRadius="10dp"
                android:bottomLeftRadius="10dp"
                android:topRightRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
