<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/primaryColor"
    android:fitsSystemWindows="true">

    <!-- Top Toolbar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="?attr/primaryColor">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/primaryTextColor"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Назад" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Обновление приложения"
            android:textColor="?attr/primaryTextColor"
            android:textSize="18sp"
            android:fontFamily="@font/open_sans_bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/lineColor" />

    <!-- Content Area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Card 1: App Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_m3_item_single"
                android:padding="24dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/ivAppIcon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="AnimeLib Logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AnimeLib Player"
                    android:textColor="?attr/primaryTextColor"
                    android:textSize="20sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tvInstalledVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Установленная версия: 1.0.0"
                    android:textColor="?attr/secondaryTextColor"
                    android:textSize="14sp"
                    android:fontFamily="@font/open_sans"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GitHub: Fazer000/AnimeLib-Player-Mobile"
                    android:textColor="?attr/accentTextColor"
                    android:textSize="12sp"
                    android:fontFamily="@font/open_sans"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Card 2: Update Check & Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_m3_item_single"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <!-- Loading State (M3 Circular Progress Indicator without waves) -->
                <LinearLayout
                    android:id="@+id/layoutLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp"
                    android:visibility="visible">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/loadingSpinner"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:indeterminate="true"
                        app:indicatorSize="28dp"
                        app:trackThickness="3dp"
                        app:indicatorColor="@color/purple_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Проверка наличия обновлений..."
                        android:textColor="?attr/primaryTextColor"
                        android:textSize="15sp"
                        android:fontFamily="@font/open_sans" />
                </LinearLayout>

                <!-- Up to Date State -->
                <LinearLayout
                    android:id="@+id/layoutUpToDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_check"
                        app:tint="#10B981" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="У вас установлена последняя версия"
                        android:textColor="?attr/primaryTextColor"
                        android:textSize="16sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvUpToDateSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Приложение не требует обновления"
                        android:textColor="?attr/secondaryTextColor"
                        android:textSize="13sp"
                        android:fontFamily="@font/open_sans"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Update Available State -->
                <LinearLayout
                    android:id="@+id/layoutUpdateAvailable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_toast_update"
                            app:tint="@color/purple_primary" />

                        <TextView
                            android:id="@+id/tvNewVersionTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Доступно обновление v1.0.1"
                            android:textColor="@color/purple_primary"
                            android:textSize="17sp"
                            android:fontFamily="@font/open_sans_bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvReleaseDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Релиз на GitHub"
                        android:textColor="?attr/secondaryTextColor"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans"
                        android:layout_marginTop="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/lineColor"
                        android:layout_marginVertical="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Что нового:"
                        android:textColor="?attr/primaryTextColor"
                        android:textSize="14.5sp"
                        android:fontFamily="@font/open_sans_bold" />

                    <TextView
                        android:id="@+id/tvReleaseNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Улучшена стабильность плеера\n• Исправлены ошибки"
                        android:textColor="?attr/secondaryTextColor"
                        android:textSize="13.5sp"
                        android:fontFamily="@font/open_sans"
                        android:layout_marginTop="6dp" />

                    <!-- In-App Download Progress Container (M3 Linear Progress Indicator without waves) -->
                    <LinearLayout
                        android:id="@+id/layoutDownloadProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvDownloadStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Загрузка обновления..."
                                android:textColor="?attr/primaryTextColor"
                                android:textSize="13sp"
                                android:fontFamily="@font/open_sans" />

                            <TextView
                                android:id="@+id/tvDownloadPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="@color/purple_primary"
                                android:textSize="13sp"
                                android:fontFamily="@font/open_sans_bold" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/downloadProgressBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            app:indicatorColor="@color/purple_primary"
                            app:trackColor="#33808080"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        style="@style/Widget.AnimeLIB.Button"
                        android:text="Скачать и установить"
                        app:icon="@drawable/ic_download"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenGithub"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        style="@style/Widget.AnimeLIB.Button.Outlined"
                        android:text="Открыть на GitHub"
                        app:icon="@drawable/ic_github"
                        app:iconGravity="textStart" />
                </LinearLayout>

                <!-- Error State -->
                <LinearLayout
                    android:id="@+id/layoutError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvErrorText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Не удалось проверить обновления"
                        android:textColor="#EF4444"
                        android:textSize="14sp"
                        android:fontFamily="@font/open_sans"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>

            <!-- Bottom Check Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckAgain"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                style="@style/Widget.AnimeLIB.Button.Outlined"
                android:text="Проверить снова"
                app:icon="@drawable/ic_refresh"
                app:iconGravity="textStart" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
