<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/primaryColor"
    android:fitsSystemWindows="true">

    <!-- Top Toolbar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/toolbar_header_bg">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/primaryTextColor"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Назад" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Обновление приложения"
            android:textColor="?attr/primaryTextColor"
            android:textSize="18sp"
            android:fontFamily="@font/open_sans_bold" />
    </LinearLayout>

    <!-- Content Area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Loading State -->
            <LinearLayout
                android:id="@+id/layoutLoading"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="@color/purple_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Проверка обновлений с GitHub..."
                    android:textColor="?attr/secondaryTextColor"
                    android:textSize="14sp"
                    android:fontFamily="@font/open_sans" />
            </LinearLayout>

            <!-- Error State -->
            <LinearLayout
                android:id="@+id/layoutError"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvErrorText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Не удалось проверить обновления"
                    android:textColor="#EF4444"
                    android:textSize="14sp"
                    android:fontFamily="@font/open_sans"
                    android:gravity="center" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckAgain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/Widget.AnimeLIB.Button.Outlined"
                    android:text="Повторить" />
            </LinearLayout>

            <!-- Up to Date State -->
            <LinearLayout
                android:id="@+id/layoutUpToDate"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_check"
                    app:tint="#10B981" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="У вас установлена последняя версия"
                    android:textColor="?attr/primaryTextColor"
                    android:textSize="16sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tvUpToDateSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Приложение не требует обновления"
                    android:textColor="?attr/secondaryTextColor"
                    android:textSize="13sp"
                    android:fontFamily="@font/open_sans"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Update Available Content (Card 1 & Card 2) -->
            <LinearLayout
                android:id="@+id/layoutUpdateAvailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Card 1: Version Details Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@color/card_bg_color"
                    android:padding="24dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/animelib_logo"
                        android:contentDescription="Logo" />

                    <TextView
                        android:id="@+id/tvNewVersionTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Доступна версия v1.8.9"
                        android:textColor="?attr/primaryTextColor"
                        android:textSize="20sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/tvVersionComparison"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="У вас: v1.8.8 → Новая: v1.8.9"
                        android:textColor="@color/purple_primary"
                        android:textSize="13.5sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/tvReleaseDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Дата публикации: 13.10.2026"
                        android:textColor="?attr/secondaryTextColor"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Section Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Что нового в этой версии:"
                    android:textColor="?attr/primaryTextColor"
                    android:textSize="15sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:layout_marginBottom="10dp" />

                <!-- Card 2: Release Notes Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/card_bg_color"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvReleaseNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="- Добавлена функция блокировки плеера\n- Добавлены настройки комментариев\n- Некоторые улучшения комментариев"
                        android:textColor="?attr/secondaryTextColor"
                        android:textSize="13.5sp"
                        android:fontFamily="@font/open_sans"
                        android:lineSpacingMultiplier="1.3" />

                    <!-- Download Progress -->
                    <LinearLayout
                        android:id="@+id/layoutDownloadProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvDownloadStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Загрузка обновления..."
                                android:textColor="?attr/primaryTextColor"
                                android:textSize="13sp"
                                android:fontFamily="@font/open_sans" />

                            <TextView
                                android:id="@+id/tvDownloadPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="@color/purple_primary"
                                android:textSize="13sp"
                                android:fontFamily="@font/open_sans_bold" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/downloadProgressBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            app:indicatorColor="@color/purple_primary"
                            app:trackColor="#33808080"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="?attr/primaryColor">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadUpdate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            style="@style/Widget.AnimeLIB.Button"
            android:text="СКАЧАТЬ И УСТАНОВИТЬ APK"
            app:icon="@drawable/ic_download"
            app:iconGravity="textStart"
            android:textSize="14sp"
            android:fontFamily="@font/open_sans_bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenGithub"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            style="@style/Widget.AnimeLIB.Button.Outlined"
            android:text="Открыть страницу на GitHub"
            app:icon="@drawable/ic_github"
            app:iconGravity="textStart"
            android:textSize="13.5sp"
            android:fontFamily="@font/open_sans_semibold" />
    </LinearLayout>

</LinearLayout>
