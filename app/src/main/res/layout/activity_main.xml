<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/statusBarColor"
    android:fitsSystemWindows="false"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Main Content Area (Videos list scrolling edge-to-edge behind status bar and under floating bottom blocks) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVideos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="12dp"
                android:paddingBottom="300dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/purple_primary"
            android:visibility="gone" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_tv"
                app:tint="@color/purple_primary"
                android:contentDescription="No Videos" />

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Видеофайлы не найдены"
                android:textColor="@color/primary_text_color"
                android:textSize="17sp"
                android:fontFamily="@font/open_sans_bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvEmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Убедитесь, что на устройстве есть видео"
                android:textColor="@color/player_item_inactive_text"
                android:textSize="13sp"
                android:fontFamily="@font/open_sans" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Обновить"
                android:textColor="@color/white_color"
                app:backgroundTint="@color/purple_primary"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- 1. Floating Bottom Navigation Card (TikTok style custom pill tabs) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/card_bg_color"
        app:cardCornerRadius="30dp"
        app:cardElevation="8dp"
        app:cardPreventCornerOverlap="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp">

            <!-- Tab 1: Explorer -->
            <LinearLayout
                android:id="@+id/tabExplorer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_selected"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:id="@+id/ivTabExplorerIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_tv"
                    app:tint="@color/white_color"
                    android:contentDescription="Проводник" />

                <TextView
                    android:id="@+id/tvTabExplorerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Проводник"
                    android:textColor="@color/white_color"
                    android:textSize="14sp"
                    android:fontFamily="@font/open_sans_bold" />
            </LinearLayout>

            <!-- Tab 2: Playlists -->
            <LinearLayout
                android:id="@+id/tabPlaylists"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:id="@+id/ivTabPlaylistsIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_episodes"
                    app:tint="@color/player_item_inactive_text"
                    android:contentDescription="Плейлисты" />

                <TextView
                    android:id="@+id/tvTabPlaylistsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Плейлисты"
                    android:textColor="@color/player_item_inactive_text"
                    android:textSize="14sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- 2. Floating Folder Carousel Card (Uniform 18dp gap above Bottom Nav) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardFolderCarousel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="88dp"
        app:cardBackgroundColor="@color/card_bg_color"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardPreventCornerOverlap="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFolders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:clipToPadding="false" />

    </androidx.cardview.widget.CardView>

    <!-- 3. Floating Control Buttons / Search Bar Container (Uniform 18dp gap above Folder Carousel) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="170dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Normal Circular Buttons (End aligned) -->
        <LinearLayout
            android:id="@+id/layoutNormalButtons"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Create Playlist Button (Individual Circle) -->
            <androidx.cardview.widget.CardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                app:cardBackgroundColor="@color/card_bg_color"
                app:cardCornerRadius="22dp"
                app:cardElevation="6dp"
                app:cardPreventCornerOverlap="false">

                <ImageButton
                    android:id="@+id/btnCreatePlaylist"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_episodes"
                    app:tint="@color/purple_primary"
                    android:padding="10dp"
                    android:contentDescription="Создать плейлист" />
            </androidx.cardview.widget.CardView>

            <!-- Sort Button (Individual Circle) -->
            <androidx.cardview.widget.CardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                app:cardBackgroundColor="@color/card_bg_color"
                app:cardCornerRadius="22dp"
                app:cardElevation="6dp"
                app:cardPreventCornerOverlap="false">

                <ImageButton
                    android:id="@+id/btnSort"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_sort_arrows"
                    app:tint="@color/primary_text_color"
                    android:padding="10dp"
                    android:contentDescription="Сортировка" />
            </androidx.cardview.widget.CardView>

            <!-- Search Toggle Button (Individual Circle) -->
            <androidx.cardview.widget.CardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                app:cardBackgroundColor="@color/card_bg_color"
                app:cardCornerRadius="22dp"
                app:cardElevation="6dp"
                app:cardPreventCornerOverlap="false">

                <ImageButton
                    android:id="@+id/btnSearchToggle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_search"
                    app:tint="@color/primary_text_color"
                    android:padding="10dp"
                    android:contentDescription="Поиск" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Expanded Search Bar (Floating Card matching full width when active) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutExpandedSearch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/card_bg_color"
            app:cardCornerRadius="24dp"
            app:cardElevation="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/purple_primary"
                    android:contentDescription="Search" />

                <EditText
                    android:id="@+id/etSearchVideos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="Поиск видео..."
                    android:textColor="@color/primary_text_color"
                    android:textColorHint="@color/player_item_inactive_text"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch" />

                <ImageButton
                    android:id="@+id/btnCloseSearch"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    app:tint="@color/player_item_inactive_text"
                    android:padding="6dp"
                    android:contentDescription="Закрыть" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <!-- 4. Playlist Creation Action Bar (Uniform 18dp gap above Control Buttons) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/layoutPlaylistCreationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="236dp"
        app:cardBackgroundColor="@color/card_bg_color"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/tvPlaylistSelectionCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Выбрано: 0"
                android:textColor="@color/primary_text_color"
                android:textSize="14sp"
                android:fontFamily="@font/open_sans_bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelPlaylist"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Отмена"
                android:textColor="@color/player_item_inactive_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDonePlaylist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Далее"
                android:textColor="@color/white_color"
                app:backgroundTint="@color/purple_primary"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>