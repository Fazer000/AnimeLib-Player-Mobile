<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryColor"
    android:fitsSystemWindows="false"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Fragment Container -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <!-- Floating Bottom Navigation Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/card_bg_color"
        app:cardCornerRadius="26dp"
        app:cardElevation="8dp"
        app:cardPreventCornerOverlap="false">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp">

            <!-- Sliding background indicator view -->
            <View
                android:id="@+id/vTabIndicator"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_tab_selected" />

            <!-- Tabs container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <!-- Tab 1: Explorer -->
                <LinearLayout
                    android:id="@+id/tabExplorer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivTabExplorerIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_tv"
                        app:tint="@color/white_color"
                        android:contentDescription="Проводник" />

                    <TextView
                        android:id="@+id/tvTabExplorerText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Проводник"
                        android:textColor="@color/white_color"
                        android:textSize="14sp"
                        android:fontFamily="@font/open_sans_bold" />
                </LinearLayout>

                <!-- Tab 2: Playlists -->
                <LinearLayout
                    android:id="@+id/tabPlaylists"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.75"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivTabPlaylistsIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_episodes"
                        app:tint="@color/player_item_inactive_text"
                        android:contentDescription="Плейлисты" />

                    <TextView
                        android:id="@+id/tvTabPlaylistsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Плейлисты"
                        android:textColor="@color/white_color"
                        android:textSize="14sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Tab 3: Settings -->
                <LinearLayout
                    android:id="@+id/tabSettings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.75"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivTabSettingsIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/player_item_inactive_text"
                        android:contentDescription="Настройки" />

                    <TextView
                        android:id="@+id/tvTabSettingsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Настройки"
                        android:textColor="@color/white_color"
                        android:textSize="14sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>