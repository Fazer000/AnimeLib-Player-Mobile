<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/statusBarColor"
    android:fitsSystemWindows="true">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/animelib_logo"
            android:contentDescription="AnimeLib Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/primary_text_color"
                android:textSize="18sp"
                android:fontFamily="@font/open_sans_bold" />

            <TextView
                android:id="@+id/tvVideoCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/player_item_inactive_text"
                android:textSize="11.5sp"
                android:fontFamily="@font/open_sans"
                android:text="Поиск видеофайлов..." />

        </LinearLayout>

        <!-- Test Mode Button -->
        <ImageButton
            android:id="@+id/btnTestMode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_play"
            app:tint="@color/purple_primary"
            android:padding="8dp"
            android:contentDescription="Тест плеера" />

        <!-- Sort Button -->
        <ImageButton
            android:id="@+id/btnSort"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_sort_arrows"
            app:tint="@color/primary_text_color"
            android:padding="8dp"
            android:contentDescription="Сортировка" />

        <!-- Refresh Button -->
        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_refresh"
            app:tint="@color/primary_text_color"
            android:padding="8dp"
            android:contentDescription="Обновить" />

    </LinearLayout>

    <!-- Search Input Box -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_search_input_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="@color/player_item_inactive_text"
            android:contentDescription="Search Icon" />

        <EditText
            android:id="@+id/etSearchVideos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="Поиск по названию видео..."
            android:textColor="@color/primary_text_color"
            android:textColorHint="@color/player_item_inactive_text"
            android:textSize="13.5sp"
            android:fontFamily="@font/open_sans"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <ImageButton
            android:id="@+id/btnClearSearch"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/player_item_inactive_text"
            android:padding="4dp"
            android:visibility="gone"
            android:contentDescription="Очистить поиск" />

    </LinearLayout>

    <!-- Folder Filter Chips Carousel -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFolders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <!-- Content Area: SwipeRefresh + RecyclerView or Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVideos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="16dp"
                android:clipToPadding="false" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/purple_primary"
            android:visibility="gone" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_tv"
                app:tint="@color/purple_primary"
                android:contentDescription="No Videos Icon" />

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Видеофайлы не найдены"
                android:textColor="@color/primary_text_color"
                android:textSize="17sp"
                android:fontFamily="@font/open_sans_bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvEmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Убедитесь, что на устройстве есть видео, или предоставьте доступ к памяти"
                android:textColor="@color/player_item_inactive_text"
                android:textSize="13sp"
                android:fontFamily="@font/open_sans" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Предоставить доступ"
                android:textColor="@color/white_color"
                app:backgroundTint="@color/purple_primary"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLaunchTestMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Запустить тест плеера"
                android:textColor="@color/purple_primary"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/purple_primary"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>