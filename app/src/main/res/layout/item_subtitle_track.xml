<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="@android:color/transparent"
    android:foreground="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/subtitleTrackFormat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/tag_fhd_background"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="ASS"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginEnd="12dp" />

    <TextView
        android:id="@+id/subtitleTrackTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Субтитры"
        android:textColor="?attr/primaryTextColor"
        android:textSize="15sp" />

    <FrameLayout
        android:id="@+id/selectedPill"
        android:layout_width="38dp"
        android:layout_height="26dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_m3_selected_pill"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_check"
            app:tint="#FFFFFF"
            android:contentDescription="Selected"/>
    </FrameLayout>

    <View
        android:id="@+id/unselectedIndicator"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_m3_unselected_circle"
        android:visibility="visible"/>
</LinearLayout>
