<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Thumbnail Stack Container: Larger preview & clearly visible translucent borderless stacked layers -->
    <FrameLayout
        android:layout_width="150dp"
        android:layout_height="86dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Layer 1: Back card (shifted up and right, borderless, semi-transparent) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="132dp"
            android:layout_height="74dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="0dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/playlist_stack_layer_1"
            app:strokeWidth="0dp" />

        <!-- Layer 2: Middle card (shifted middle up and right, borderless, semi-transparent) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="132dp"
            android:layout_height="74dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/playlist_stack_layer_2"
            app:strokeWidth="0dp" />

        <!-- Layer 3: Main Front Card with Video Thumbnail -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="132dp"
            android:layout_height="74dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="10dp"
            android:layout_marginStart="0dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/card_bg_color"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivPlaylistThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_image"
                android:contentDescription="Превью плейлиста" />

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <!-- Playlist Info: Name, Video Count, Creation Date -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPlaylistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/primary_text_color"
            android:textSize="16sp"
            android:fontFamily="@font/open_sans_bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Название плейлиста" />

        <TextView
            android:id="@+id/tvPlaylistVideoCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/player_item_inactive_text"
            android:textSize="13sp"
            android:fontFamily="@font/open_sans"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="0 видео • 19.10.2026" />

    </LinearLayout>

    <!-- Chevron Arrow Right -->
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/player_item_inactive_text"
        android:contentDescription="Открыть" />

</LinearLayout>
