<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardVideoItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/card_bg_color"
    app:strokeColor="?attr/alphaBorderColor"
    app:strokeWidth="0.8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <!-- Thumbnail Container -->
        <FrameLayout
            android:layout_width="126dp"
            android:layout_height="76dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/black_color"
                app:cardPreventCornerOverlap="false">

                <ImageView
                    android:id="@+id/ivVideoThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_image"
                    android:contentDescription="Video Thumbnail" />

                <!-- Duration badge in bottom-left corner -->
                <TextView
                    android:id="@+id/tvVideoDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_video_thumbnail_badge"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="00:00"
                    android:textColor="@color/white_color"
                    android:textSize="10sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:includeFontPadding="false" />

                <!-- Watch progress percentage badge in bottom-right corner -->
                <TextView
                    android:id="@+id/tvWatchProgressStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_video_thumbnail_badge"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="0%"
                    android:textColor="@color/white_color"
                    android:textSize="10sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:includeFontPadding="false"
                    android:visibility="gone" />

            </androidx.cardview.widget.CardView>

            <!-- Numbering / selection badge in top-left corner -->
            <TextView
                android:id="@+id/tvSelectionBadge"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|start"
                android:layout_margin="5dp"
                android:background="@drawable/bg_m3_selected_pill"
                android:textColor="@color/white_color"
                android:textSize="11.5sp"
                android:fontFamily="@font/open_sans_bold"
                android:gravity="center"
                android:visibility="gone"
                android:elevation="3dp" />

        </FrameLayout>

        <!-- Video Metadata / Description -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_text_color"
                android:textSize="14sp"
                android:fontFamily="@font/open_sans_bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.15"
                android:text="Название видеофайла.mp4" />

            <!-- Folder tag & File size / Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvVideoFolder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_search_pill_badge"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/purple_primary"
                    android:textSize="10sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:text="Downloads" />

                <TextView
                    android:id="@+id/tvVideoSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:textColor="@color/player_item_inactive_text"
                    android:textSize="11sp"
                    android:text="250 МБ • 14.10.2026" />

            </LinearLayout>

            <!-- M3 Linear Progress Indicator in description -->
            <com.example.animelib.ui.M3LinearProgressIndicator
                android:id="@+id/pbWatchProgress"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="7dp"
                android:max="100"
                android:progress="0"
                app:m3TrackHeight="4.5dp"
                app:m3GapSize="3dp"
                app:m3StopDotSize="3.5dp"
                app:m3ShowStopDot="true"
                app:m3IndicatorColor="@color/purple_primary"
                app:m3TrackColor="@color/purple_alpha_25"
                app:m3StopDotColor="@color/purple_primary"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
