<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlaylists"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        android:paddingBottom="120dp" />

    <!-- Playlists Empty State -->
    <LinearLayout
        android:id="@+id/layoutPlaylistsEmptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_episodes"
            app:tint="@color/player_item_inactive_text"
            android:contentDescription="No Playlists" />

        <TextView
            android:id="@+id/tvEmptyPlaylistsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Нет сохраненных плейлистов"
            android:textColor="@color/primary_text_color"
            android:textSize="18sp"
            android:fontFamily="@font/open_sans_bold" />

        <TextView
            android:id="@+id/tvEmptyPlaylistsSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Создайте свой первый плейлист в разделе «Проводник»"
            android:textColor="@color/player_item_inactive_text"
            android:textSize="14sp"
            android:gravity="center"
            android:fontFamily="@font/open_sans_semibold" />

    </LinearLayout>

</FrameLayout>
