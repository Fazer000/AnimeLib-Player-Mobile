<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Playlists RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlaylists"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:paddingTop="80dp"
        android:paddingBottom="120dp" />

    <!-- Playlists Empty State -->
    <LinearLayout
        android:id="@+id/layoutPlaylistsEmptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_episodes"
            app:tint="@color/player_item_inactive_text"
            android:contentDescription="Нет плейлистов" />

        <TextView
            android:id="@+id/tvEmptyPlaylistsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Нет сохраненных плейлистов"
            android:textColor="@color/primary_text_color"
            android:textSize="18sp"
            android:fontFamily="@font/open_sans_bold" />

        <TextView
            android:id="@+id/tvEmptyPlaylistsSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Создайте плейлист, чтобы быстро находить любимые серии"
            android:textColor="@color/player_item_inactive_text"
            android:textSize="14sp"
            android:gravity="center"
            android:fontFamily="@font/open_sans_semibold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmptyCreatePlaylist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Создать плейлист"
            android:textColor="@color/white_color"
            app:backgroundTint="@color/accent_color"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/white_color"
            android:fontFamily="@font/open_sans_bold" />

    </LinearLayout>

    <!-- Top Header Bar with Title & Create Playlist Action Button -->
    <LinearLayout
        android:id="@+id/layoutPlaylistsTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/tvPlaylistsHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Плейлисты"
            android:textColor="@color/primary_text_color"
            android:fontFamily="@font/open_sans_bold"
            android:textSize="22sp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardCreatePlaylistHeader"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="@color/card_bg_color"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardPreventCornerOverlap="false">

            <ImageButton
                android:id="@+id/btnCreatePlaylistHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_add"
                app:tint="@color/accent_color"
                android:padding="12dp"
                android:contentDescription="Создать плейлист" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</FrameLayout>
