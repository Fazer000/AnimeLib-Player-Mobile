<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="12dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_m3_item_single"
    android:clickable="true"
    android:focusable="true">

    <!-- Playlist Cover / Icon -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/black_color">

        <ImageView
            android:id="@+id/ivItemPlaylistThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_image"
            android:contentDescription="Обложка" />

        <ImageView
            android:id="@+id/ivItemPlaylistFallback"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_episodes"
            app:tint="@color/accent_color"
            android:visibility="gone"
            android:contentDescription="Иконка плейлиста" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Playlist Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemPlaylistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Название плейлиста"
            android:textColor="@color/primary_text_color"
            android:fontFamily="@font/open_sans_bold"
            android:textSize="15.5sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvItemPlaylistCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0 видео"
            android:textColor="@color/player_item_inactive_text"
            android:fontFamily="@font/open_sans"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Checkmark Pill when active (video is in playlist) -->
    <FrameLayout
        android:id="@+id/itemSelectedPill"
        android:layout_width="38dp"
        android:layout_height="26dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_m3_selected_pill"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_check"
            app:tint="#FFFFFF"
            android:contentDescription="Выбрано" />
    </FrameLayout>

    <!-- Unselected Circle when inactive (video not in playlist) -->
    <View
        android:id="@+id/itemUnselectedCircle"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_m3_unselected_circle"
        android:visibility="visible" />

</LinearLayout>
