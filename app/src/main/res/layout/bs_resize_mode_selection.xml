<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        android:background="@android:color/transparent">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/bottom_sheet_handle"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/bs_resize_back"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="6dp"
                app:tint="@color/accent_text_color"
                android:background="@drawable/button_close_background"
                android:src="@drawable/ic_arrow_back"
                android:scaleType="fitCenter"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bs_title_resize_mode"
                android:gravity="center_vertical"
                android:textColor="@color/primary_text_color"
                android:textStyle="bold"
                android:fontFamily="@font/open_sans_bold"
                android:paddingVertical="8dp"
                android:layout_marginStart="8dp"
                android:textSize="@dimen/bs_title_text_size"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/bs_divider_color"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Row 1: Fit ("нет") & Fill ("Растянуть") -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Card 1: Fit ("С полями") -->
                <LinearLayout
                    android:id="@+id/resizeFitOption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/card_ripple_effect">

                    <FrameLayout
                        android:id="@+id/resizeFitCardBox"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:background="@drawable/card_resize_selected"
                        android:padding="3dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToOutline="true"
                            android:background="@drawable/bg_resize_preview_inner">

                            <!-- Pillarbox vertical side bars -->
                            <View
                                android:layout_width="10dp"
                                android:layout_height="match_parent"
                                android:layout_alignParentStart="true"
                                android:background="#161B22" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="match_parent"
                                android:layout_alignParentEnd="true"
                                android:background="#161B22" />

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_centerInParent="true"
                                android:src="@drawable/ic_resize_mode_fit"
                                app:tint="#FFFFFF" />
                        </RelativeLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="С полями"
                            android:textColor="@color/primary_text_color"
                            android:textSize="14sp"
                            android:fontFamily="@font/open_sans_bold" />

                        <ImageView
                            android:id="@+id/resizeFitCheck"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_check"
                            app:tint="@color/purple_primary"
                            android:visibility="visible" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Card 2: Fill ("Растянуть") -->
                <LinearLayout
                    android:id="@+id/resizeFillOption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/card_ripple_effect">

                    <FrameLayout
                        android:id="@+id/resizeFillCardBox"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:background="@drawable/card_resize_unselected"
                        android:padding="3dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToOutline="true"
                            android:background="@drawable/bg_resize_preview_inner">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_centerInParent="true"
                                android:src="@drawable/ic_resize_mode_stretch"
                                app:tint="#FFFFFF" />
                        </RelativeLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Растянуть"
                            android:textColor="@color/primary_text_color"
                            android:textSize="14sp"
                            android:fontFamily="@font/open_sans_bold" />

                        <ImageView
                            android:id="@+id/resizeFillCheck"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_check"
                            app:tint="@color/purple_primary"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Row 2: Zoom ("Обрезать") -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Card 3: Zoom ("Обрезать") -->
                <LinearLayout
                    android:id="@+id/resizeZoomOption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/card_ripple_effect">

                    <FrameLayout
                        android:id="@+id/resizeZoomCardBox"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:background="@drawable/card_resize_unselected"
                        android:padding="3dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToOutline="true"
                            android:background="@drawable/bg_resize_preview_inner">

                            <!-- Top Crop Dashed Line -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="2dp"
                                android:layout_alignParentTop="true"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_crop_dashed_line" />

                            <!-- Bottom Crop Dashed Line -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="2dp"
                                android:layout_alignParentBottom="true"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_crop_dashed_line" />

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_centerInParent="true"
                                android:src="@drawable/ic_resize_mode_crop"
                                app:tint="#FFFFFF" />
                        </RelativeLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Обрезать"
                            android:textColor="@color/primary_text_color"
                            android:textSize="14sp"
                            android:fontFamily="@font/open_sans_bold" />

                        <ImageView
                            android:id="@+id/resizeZoomCheck"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_check"
                            app:tint="@color/purple_primary"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Spacer to balance grid in row 2 -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
