<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:background="@android:color/transparent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        android:background="@android:color/transparent">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/bottom_sheet_handle"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/bs_theme_back"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="6dp"
                app:tint="@color/accent_text_color"
                android:background="@drawable/button_close_background"
                android:src="@drawable/ic_arrow_back"
                android:scaleType="fitCenter"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bs_title_theme"
                android:gravity="center_vertical"
                android:textColor="@color/primary_text_color"
                android:textStyle="bold"
                android:fontFamily="@font/open_sans_bold"
                android:paddingVertical="8dp"
                android:layout_marginStart="8dp"
                android:textSize="@dimen/bs_title_text_size"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="8dp">

            <!-- Auto Theme Option -->
            <LinearLayout
                android:id="@+id/themeAutoOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp"
                android:layout_marginBottom="3dp"
                android:background="@drawable/bg_m3_item_top"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_auto"
                    app:tint="@color/primary_text_color"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="Auto theme"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Авто"
                    android:textColor="@color/primary_text_color"
                    android:fontFamily="@font/open_sans_bold"
                    android:textSize="15.5sp"/>

                <FrameLayout
                    android:id="@+id/themeAutoPill"
                    android:layout_width="38dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_selected_pill"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        app:tint="#FFFFFF"
                        android:contentDescription="Selected"/>
                </FrameLayout>

                <View
                    android:id="@+id/themeAutoUnselected"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_unselected_circle"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Light Theme Option -->
            <LinearLayout
                android:id="@+id/themeLightOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp"
                android:layout_marginBottom="3dp"
                android:background="@drawable/bg_m3_item_middle"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_light"
                    app:tint="@color/primary_text_color"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="Light theme"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Светлая"
                    android:textColor="@color/primary_text_color"
                    android:fontFamily="@font/open_sans_bold"
                    android:textSize="15.5sp"/>

                <FrameLayout
                    android:id="@+id/themeLightPill"
                    android:layout_width="38dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_selected_pill"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        app:tint="#FFFFFF"
                        android:contentDescription="Selected"/>
                </FrameLayout>

                <View
                    android:id="@+id/themeLightUnselected"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_unselected_circle"
                    android:visibility="visible"/>
            </LinearLayout>

            <!-- Dark Theme Option -->
            <LinearLayout
                android:id="@+id/themeDarkOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp"
                android:background="@drawable/bg_m3_item_bottom"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_night"
                    app:tint="@color/primary_text_color"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="Dark theme"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Темная"
                    android:textColor="@color/primary_text_color"
                    android:fontFamily="@font/open_sans_bold"
                    android:textSize="15.5sp"/>

                <FrameLayout
                    android:id="@+id/themeDarkPill"
                    android:layout_width="38dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_selected_pill"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        app:tint="#FFFFFF"
                        android:contentDescription="Selected"/>
                </FrameLayout>

                <View
                    android:id="@+id/themeDarkUnselected"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_unselected_circle"
                    android:visibility="visible"/>
            </LinearLayout>

            <!-- Accent Color Section Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="Главный акцентный цвет плеера"
                android:textColor="@color/primary_text_color"
                android:fontFamily="@font/open_sans_bold"
                android:textSize="15sp" />

            <!-- Accent Swatches Card Grid/List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. AnimeLIB Purple -->
                <LinearLayout
                    android:id="@+id/accentPurpleOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/bg_m3_item_top"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_m3_unselected_circle"
                        android:backgroundTint="#8B5CF6"
                        android:layout_marginEnd="14dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Фиолетовый (AnimeLIB Purple)"
                        android:textColor="@color/primary_text_color"
                        android:fontFamily="@font/open_sans_bold"
                        android:textSize="14.5sp" />

                    <TextView
                        android:id="@+id/tagPurpleCurrent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="АКТИВЕН"
                        android:textColor="#8B5CF6"
                        android:textSize="11sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:visibility="visible" />
                </LinearLayout>

                <!-- 2. Cyber Cyan -->
                <LinearLayout
                    android:id="@+id/accentCyanOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/bg_m3_item_middle"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_m3_unselected_circle"
                        android:backgroundTint="#00E5FF"
                        android:layout_marginEnd="14dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Кибер Неон (Cyber Cyan)"
                        android:textColor="@color/primary_text_color"
                        android:fontFamily="@font/open_sans_bold"
                        android:textSize="14.5sp" />

                    <TextView
                        android:id="@+id/tagCyanCurrent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="АКТИВЕН"
                        android:textColor="#00E5FF"
                        android:textSize="11sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 3. Electric Cobalt -->
                <LinearLayout
                    android:id="@+id/accentCobaltOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/bg_m3_item_middle"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_m3_unselected_circle"
                        android:backgroundTint="#3B82F6"
                        android:layout_marginEnd="14dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Кобальт (Electric Cobalt)"
                        android:textColor="@color/primary_text_color"
                        android:fontFamily="@font/open_sans_bold"
                        android:textSize="14.5sp" />

                    <TextView
                        android:id="@+id/tagCobaltCurrent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="АКТИВЕН"
                        android:textColor="#3B82F6"
                        android:textSize="11sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 4. Neon Emerald -->
                <LinearLayout
                    android:id="@+id/accentEmeraldOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/bg_m3_item_middle"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_m3_unselected_circle"
                        android:backgroundTint="#10B981"
                        android:layout_marginEnd="14dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Изумруд (Neon Emerald)"
                        android:textColor="@color/primary_text_color"
                        android:fontFamily="@font/open_sans_bold"
                        android:textSize="14.5sp" />

                    <TextView
                        android:id="@+id/tagEmeraldCurrent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="АКТИВЕН"
                        android:textColor="#10B981"
                        android:textSize="11sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 5. Cinema Crimson -->
                <LinearLayout
                    android:id="@+id/accentCrimsonOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/bg_m3_item_middle"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_m3_unselected_circle"
                        android:backgroundTint="#FF2E63"
                        android:layout_marginEnd="14dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Кино Рубин (Cinema Crimson)"
                        android:textColor="@color/primary_text_color"
                        android:fontFamily="@font/open_sans_bold"
                        android:textSize="14.5sp" />

                    <TextView
                        android:id="@+id/tagCrimsonCurrent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="АКТИВЕН"
                        android:textColor="#FF2E63"
                        android:textSize="11sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 6. Sunset Amber -->
                <LinearLayout
                    android:id="@+id/accentAmberOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/bg_m3_item_middle"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_m3_unselected_circle"
                        android:backgroundTint="#F59E0B"
                        android:layout_marginEnd="14dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Солнечный Янтарь (Sunset Amber)"
                        android:textColor="@color/primary_text_color"
                        android:fontFamily="@font/open_sans_bold"
                        android:textSize="14.5sp" />

                    <TextView
                        android:id="@+id/tagAmberCurrent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="АКТИВЕН"
                        android:textColor="#F59E0B"
                        android:textSize="11sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 7. Cosmic Indigo -->
                <LinearLayout
                    android:id="@+id/accentIndigoOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/bg_m3_item_middle"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_m3_unselected_circle"
                        android:backgroundTint="#6366F1"
                        android:layout_marginEnd="14dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Космический Индиго (Cosmic Indigo)"
                        android:textColor="@color/primary_text_color"
                        android:fontFamily="@font/open_sans_bold"
                        android:textSize="14.5sp" />

                    <TextView
                        android:id="@+id/tagIndigoCurrent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="АКТИВЕН"
                        android:textColor="#6366F1"
                        android:textSize="11sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 8. Sakura Pink -->
                <LinearLayout
                    android:id="@+id/accentSakuraOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp"
                    android:background="@drawable/bg_m3_item_bottom"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_m3_unselected_circle"
                        android:backgroundTint="#EC4899"
                        android:layout_marginEnd="14dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Сакура Неон (Sakura Pink)"
                        android:textColor="@color/primary_text_color"
                        android:fontFamily="@font/open_sans_bold"
                        android:textSize="14.5sp" />

                    <TextView
                        android:id="@+id/tagSakuraCurrent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="АКТИВЕН"
                        android:textColor="#EC4899"
                        android:textSize="11sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
